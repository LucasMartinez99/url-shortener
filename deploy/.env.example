# PostgreSQL
DB_NAME=urlshortener
DB_USERNAME=urlshortener
DB_PASSWORD=change_me_strong_password

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=change_me_base64_encoded_secret_at_least_256_bits
JWT_EXPIRATION=86400000

# Public URL of this deployment (no trailing slash)
APP_BASE_URL=https://urls.syspar.com.py

# Allowed CORS origins (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://urls.syspar.com.py

# Name of the external Docker network owned by nginx-proxy
PROXY_NETWORK=urlshortener_proxy_network
